# Deterministic local parsing remains the safe default.
LLM_PROVIDER=offline

# To use the OpenAI Responses API, replace "offline" above with "openai",
# fill in both values below, and pass this file explicitly with:
# control-tower ... chat --llm-config .env
LLM_MODEL=
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=30
